{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Zanate (Linux Desktop)",
      "cwd": "comunidad_universitaria",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "linux",
        "--dart-define=GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
        "--dart-define=GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET"
      ]
    },
    {
      "name": "Zanate (Android)",
      "cwd": "comunidad_universitaria",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "android",
        "--dart-define=GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Zanate (Chrome Web)",
      "cwd": "comunidad_universitaria",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port=8080",
        "--dart-define=GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Zanate (Windows Desktop)",
      "cwd": "comunidad_universitaria",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows",
        "--dart-define=GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
        "--dart-define=GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET"
      ]
    }
  ]
}
